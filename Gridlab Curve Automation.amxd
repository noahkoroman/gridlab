 "code": {
  "curve_engine.js": "autowatch=1;inlets=1;outlets=1;var length=1000,amplitude=1,smoothness=.5,shape=0,frequency=1,bounceDecay=.7,curvePower=0,phase=0,time=0,lastValue=0,randomBuffer=[],bounceVelocity=0,bouncePosition=1;function initRandomBuffer(){randomBuffer=[];for(var e=0;e<128;e++)randomBuffer.push(Math.random())}function bang(){var e=generateCurveValue();outlet(0,e)}function setLength(e){length=Math.max(100,Math.min(10000,e))}function setAmplitude(e){amplitude=Math.max(0,Math.min(1,e))}function setSmoothness(e){smoothness=Math.max(0,Math.min(1,e))}function setShape(e){shape=Math.floor(e),4===shape&&(bouncePosition=1,bounceVelocity=0),8===shape&&initRandomBuffer()}function setFrequency(e){frequency=Math.max(.1,Math.min(50,e))}function setBounce(e){bounceDecay=Math.max(0,Math.min(.95,e))}function setCurve(e){curvePower=Math.max(-5,Math.min(5,e))}function msg_int(e){bang()}function msg_float(e){bang()}function list(){for(var e=arrayfromargs(arguments),a=0;a<e.length;a+=2){var t=e[a],n=e[a+1];switch(t){case 0:setLength(n);break;case 1:setAmplitude(n);break;case 2:setSmoothness(n);break;case 3:setShape(n);break;case 4:setFrequency(n);break;case 5:setBounce(n);break;case 6:setCurve(n)}}}function easeInQuad(e){return e*e}function easeOutQuad(e){return e*(2-e)}function easeInOutQuad(e){return e<.5?2*e*e:-1+(4-2*e)*e}function easeInCubic(e){return e*e*e}function easeOutCubic(e){return--e*e*e+1}function easeInOutCubic(e){return e<.5?4*e*e*e:(e-1)*(2*e-2)*(2*e-2)+1}function applyCurvePower(e,a){return 0===a?e:a>0?Math.pow(e,1+a):Math.pow(e,1/(1-a))}function updateBounce(){var e=.05,a=bounceDecay;return bounceVelocity-=e,bouncePosition+=bounceVelocity,bouncePosition<=0&&(bouncePosition=0,bounceVelocity=-bounceVelocity*a,Math.abs(bounceVelocity)<.01&&(bouncePosition=1,bounceVelocity=0)),Math.max(0,Math.min(1,bouncePosition))}function generateCurveValue(){var e=frequency/(length/10);phase+=e,phase>=1&&(phase-=Math.floor(phase),4===shape&&(bouncePosition=1,bounceVelocity=0),8===shape&&initRandomBuffer());var a=0;switch(shape){case 0:a=(Math.sin(2*phase*Math.PI)+1)/2;break;case 1:a=phase<.5?2*phase:2-2*phase;break;case 2:a=phase;break;case 3:a=1-phase;break;case 4:a=updateBounce();break;case 5:a=easeInCubic(phase);break;case 6:a=easeOutCubic(phase);break;case 7:a=easeInOutCubic(phase);break;case 8:var t=Math.floor(phase*randomBuffer.length);a=randomBuffer[t%randomBuffer.length];break;case 9:a=(Math.exp(3*phase)-1)/(Math.exp(3)-1);break;default:a=phase}a=applyCurvePower(a,curvePower);var n=1-smoothness,o=a*n+lastValue*smoothness;return o*=amplitude,lastValue=o,o}function reset(){phase=0,time=0,lastValue=0,bouncePosition=1,bounceVelocity=0,initRandomBuffer()}function getWaveform(){for(var e=[],a=phase,t=lastValue,n=0;n<128;n++){var o=n/128,i=0;switch(shape){case 0:i=(Math.sin(2*o*Math.PI)+1)/2;break;case 1:i=o<.5?2*o:2-2*o;break;case 2:i=o;break;case 3:i=1-o;break;case 5:i=easeInCubic(o);break;case 6:i=easeOutCubic(o);break;case 7:i=easeInOutCubic(o);break;case 8:i=randomBuffer[n%randomBuffer.length];break;case 9:i=(Math.exp(3*o)-1)/(Math.exp(3)-1);break;default:i=o}i=applyCurvePower(i,curvePower)*amplitude,e.push(i)}return phase=a,lastValue=t,outlet(0,e)}initRandomBuffer();"
 }
